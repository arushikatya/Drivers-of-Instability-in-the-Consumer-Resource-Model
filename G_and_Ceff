function [G, Ceff] = G_and_Ceff(c, w, l, D, Rstar)
% G_AND_CEFF  Growth matrix G and the effective consumption matrix
% C_eff (raw consumption net of recycling), evaluated at Rstar.
%   G(i,alpha)    = c(i,alpha) * (1-l_alpha) * w_alpha
%   T(alpha,i)    = sum_beta l_beta c(i,beta) D(alpha,beta) (w_beta/w_alpha) Rstar_beta
%   Ceff(i,alpha) = c(i,alpha) - T(alpha,i)/Rstar_alpha
    G = c .* ((1-l).*w);                     % G(i,alpha)
    weighted = c .* (l.*w.*Rstar');          % (NS x NR)
    T = (D * weighted') ./ w';               % (NR x NS): T(alpha,i)
    Ceff = c - (T' ./ Rstar');               % Ceff(i,alpha)
end
